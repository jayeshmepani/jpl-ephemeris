{
    "semi": true,
    "singleQuote": true,
    "singleAttributePerLine": false,
    "printWidth": 200,
    "tabWidth": 4,
    "trailingComma": "none",
    "useTabs": false,
    "bracketSpacing": true,
    "arrowParens": "always",
    "htmlWhitespaceSensitivity": "ignore",
    "overrides": [
        {
            "files": "**/*.yml",
            "options": {
                "tabWidth": 2
            }
        }
    ]
}