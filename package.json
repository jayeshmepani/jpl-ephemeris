{
  "name": "jpl-ephemeris-docs",
  "private": true,
  "version": "1.3.0",
  "description": "Lint and format the JPL Moshier Ephemeris HTML reference.",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint docs/script.js",
    "lint:css": "stylelint docs/style.css",
    "lint:html": "htmlhint docs/index.html",
    "lint:fix": "eslint docs/script.js --fix && stylelint docs/style.css --fix",
    "format": "prettier --write \"**/*.{html,css,js}\"",
    "format:check": "prettier --check \"**/*.{html,css,js}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "htmlhint": "^1.9.2",
    "prettier": "^3.9.7",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
